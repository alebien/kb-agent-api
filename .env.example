# DeepSeek API 凭据，从 platform.deepseek.com 创建
DEEPSEEK_API_KEY=
# 兼容 OpenAI 协议的地址，换供应商时只改这里
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名；本项目用推理型 deepseek-flash，实际模型以响应返回的 model 字段为准
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled 首字更快更省，enabled 推理更强；只接受 enabled / disabled
DEEPSEEK_THINKING=disabled
